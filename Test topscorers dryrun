 *   const res = await fetch(`https://api.webflow.com/v2/collections/${collectionId}/items`, {
 *     headers: { Authorization: `Bearer ${process.env.WEBFLOW_API_TOKEN}` },
 *   });
 *   const data = await res.json();
 *   return data.items; // already { id, fieldData } shaped
